{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin"
  },
  "scroll": {
    "acceleration": true
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true,
  "mouse": true,
  "cursor": {
    "style": "line",
    "blinking": true
  },
  "plugins": ["./herdr-opencode"]
}

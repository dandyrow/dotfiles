**/zsh/plugins
.zcompdump

# Secrets directory — contains hashed passwords, must never be committed.
secrets/
corp.pem

# Ignore all gnupg files apart from the config files
gnupg/.local/share/gnupg/
!gnupg/.local/share/gnupg/gpg-agent.conf
!gnupg/.local/share/gnupg/gpg.conf

# Ignore all copilot runtime state, keep only the stowed config files.
copilot/.config/copilot/*
!copilot/.config/copilot/mcp-config.json
!copilot/.config/copilot/copilot-instructions.md
!copilot/.config/copilot/settings.json
!copilot/.config/copilot/hooks
!copilot/.config/copilot/hooks/**

# Nix build outputs
result
result-*
*.wsl

# Superpowers design/plan files — local use only, not for version control
docs/superpowers/

# Opencode config — npm dependency scaffolding, keep only hand-written config + plugin sources
opencode/.config/opencode/node_modules/
opencode/.config/opencode/package.json
opencode/.config/opencode/package-lock.json
opencode/.config/opencode/bun.lock

# Git worktrees
.worktrees/

# Files created by agent-start.sh inside worktrees — local only, not for VCS
.ai-coauthor.txt
.AI_WORKFLOW.md
.githooks/
scripts/ai-commit

# Herdr state
herdr/.config/herdr/session.json
herdr/.config/herdr/session-history.json
herdr/.config/herdr/herdr-server.log
herdr/.config/herdr/herdr-client.log
herdr/.config/herdr/herdr-client.sock
herdr/.config/herdr/herdr.sock
herdr/.config/herdr/plugins.json
herdr/.config/herdr/.plugins.lock
